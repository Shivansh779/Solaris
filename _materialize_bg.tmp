"""Materialize iCloud-evicted (dataless) files by reading them.

Usage: python _materialize_bg.tmp <tree> <tree2> ...
Reads the first byte of every file whose st_blocks is 0 (dataless),
which makes fileproviderd fetch the content from iCloud.
"""
import os
import sys
import time

def main():
    roots = sys.argv[1:]
    ok = 0
    fail = 0
    skipped = 0
    failed = []
    start = time.time()
    for root in roots:
        print(f"=== {root} ===", flush=True)
        for dirpath, dirnames, filenames in os.walk(root):
            for fn in filenames:
                path = os.path.join(dirpath, fn)
                try:
                    st = os.lstat(path)
                    if st.st_blocks == 0 and st.st_size > 0:
                        with open(path, "rb") as fh:
                            fh.read(1)
                        ok += 1
                        if ok % 250 == 0:
                            print(f"  materialized {ok} files, {time.time()-start:.0f}s", flush=True)
                        time.sleep(0.02)
                    else:
                        skipped += 1
                except Exception as exc:  # noqa: BLE001
                    fail += 1
                    failed.append((path, str(exc)))
                    if fail % 50 == 0:
                        print(f"  failures so far: {fail}", flush=True)
    print(f"done: materialized={ok} skipped={skipped} failures={fail} elapsed={time.time()-start:.0f}s", flush=True)
    for path, exc in failed[:25]:
        print(f"FAIL {path}: {exc}", flush=True)

if __name__ == "__main__":
    main()
